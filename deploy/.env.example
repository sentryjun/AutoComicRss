# Run Compose from the repository root with --env-file deploy/.env.
# This file is for Compose interpolation, not a shell script.
HOST_PORT=8080
IMAGE_TAG=local
DATABASE_URL=sqlite:///app/data/ani.db
POLL_INTERVAL_SECONDS=300
RUST_LOG=info
MIKAN_BASE_URL=https://mikanani.me
BANGUMI_BASE_URL=https://api.bgm.tv

# Container localhost is the container itself. Use a reachable proxy/NAS address.
# WEBSITE_PROXY_URL=http://host.docker.internal:7897
# WEBSITE_DIRECT_HOSTS=192.168.1.10

# Optional local media overlay. Application root is /media, not this host path.
# MEDIA_PATH=/volume1/media/anime
# MEDIA_GID=100

# Optional MySQL overlay; generate TWO different values with openssl rand -hex 24.
# Use only hex for MYSQL_PASSWORD because it is embedded in the connection URL.
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# Optional HTTPS overlay. Use a DNS domain without scheme or path.
# SITE_ADDRESS=anime.example.com
# ADMIN_USER=admin
# Use single quotes around the bcrypt hash to preserve its dollar signs.
# ADMIN_PASSWORD_HASH='$2a$...'

# Optional initial qBittorrent import; otherwise configure in the management UI.
# QBIT_URL=http://192.168.1.10:8081
# QBIT_USERNAME=admin
# QBIT_PASSWORD='replace-me'
# QBIT_SAVE_PATH=/downloads
