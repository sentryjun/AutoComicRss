# Copy values into your shell, or source a private .env file before cargo run.
# This application does not automatically load .env files.
APP_PORT=8080
DATABASE_URL=sqlite://data/ani.db
POLL_INTERVAL_SECONDS=300
RUST_LOG=info

# Website requests (Mikan pages/covers, RSS and torrent metadata).
# Unset means direct; HTTP_PROXY/HTTPS_PROXY/ALL_PROXY/NO_PROXY are NOT inherited.
MIKAN_BASE_URL=https://mikanani.me
# WEBSITE_PROXY_URL=http://127.0.0.1:7897
# WEBSITE_PROXY_URL=socks5h://127.0.0.1:7897
# Optional URL-encoded credentials: http://username:password@host:port
# Comma-separated explicit direct exceptions; empty by default.
# WEBSITE_DIRECT_HOSTS=localhost,127.0.0.1,::1
# qBittorrent control connections always remain direct.

# Initial import only, when the database has no downloader instances.
# Existing instances and the global selection are managed through /api/downloaders.
# When upgrading, these MUST identify the original downloader of existing jobs.
# Unset on a fresh installation leaves jobs unassigned until first selection.
# QBIT_URL=http://127.0.0.1:8081
# QBIT_USERNAME=admin
# QBIT_PASSWORD=replace-me
# Path as seen by qBittorrent, not by this Rust process.
# QBIT_SAVE_PATH=/downloads
